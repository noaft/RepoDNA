# Recommended: override the default RepoDNA storage root.
# RepoDNA creates one graph directory per repository under this root.
# Default on Windows: %LOCALAPPDATA%\RepoDNA
# Default on Unix-like systems: ~/.repodna
REPODNA_HOME=D:\RepoDNA\.repodna

# Optional: pin RepoDNA to one fixed SQLite file.
# Use only when you intentionally want to manage a per-repo database path yourself.
# If set, REPODNA_DB_PATH overrides REPODNA_HOME.
# REPODNA_DB_PATH=D:\RepoDNA\.repodna\repo-a\graph.db

# Optional: choose the embedding backend for saved function summaries.
# Defaults to local Nomic via fastembed.
# REPODNA_EMBEDDING_PROVIDER=nomic

# Optional: choose the embedding model for REPODNA_EMBEDDING_PROVIDER=openai.
# Defaults to text-embedding-3-small. The local nomic provider uses its fixed model.
# REPODNA_EMBEDDING_MODEL=text-embedding-3-small

# Required only when REPODNA_EMBEDDING_PROVIDER=openai.
# OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible API base URL for local or third-party servers.
# Defaults to https://api.openai.com/v1.
# OPENAI_BASE_URL=http://localhost:11434/v1
