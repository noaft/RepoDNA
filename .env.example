# Optional: pin RepoDNA to one fixed SQLite file.
# If set, RepoDNA stores `graph.db` here and writes `state.json`
# into the same directory.
REPODNA_DB_PATH=D:\RepoDNA\data\graph.db

# Optional: override the default RepoDNA storage root.
# Default on Windows: %LOCALAPPDATA%\RepoDNA
# Default on Unix-like systems: ~/.repodna
REPODNA_HOME=D:\RepoDNA
